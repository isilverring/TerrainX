    "invalid": "Exclude nonfinite elevations and pixels whose EDM==0 or FLM==0. Honor actual raster mask/nodata. These GLO90 DEM files declare no scalar nodata; do not invent a zero-elevation or -32767 fill convention.",
    "EDM": {
      "0": "Void (no data)",
      "1": "Not edited",
      "2": "Infill of external elevation data",
      "3": "Interpolated pixels",
      "4": "Smoothed pixels",
      "5": "Airport editing",
      "6": "Raised negative elevation pixels",
      "7": "Flattened pixels",
      "8": "Ocean pixels",
      "9": "Lake pixels",
      "10": "River pixels",
      "11": "Shoreline pixels",
      "12": "Morphed pixels",
      "13": "Shifted pixels"
    },
    "FLM": {
      "0": "Void (no data)",
      "1": "Edited (except filled pixels)",
      "2": "Not edited / not filled",
      "3": "ASTER",
      "4": "SRTM90",
      "5": "SRTM30",
      "6": "GMTED2010",
      "7": "SRTM30plus",
      "8": "TerraSAR-X Radargrammetric DEM",
      "9": "AW3D30",
      "100": "Norway DEM",
      "101": "DSM05 Spain",
      "102": "Norway DEM v2"
    },
    "WBM": {
      "0": "No water",
      "1": "Ocean",
      "2": "Lake",
      "3": "River"
    },
    "interpretation": "Water codes identify edited/flattened water-surface elevations, not lake-floor bathymetry. DSM includes vegetation/buildings; report filled/edited/water fractions. Masks do not establish mineralogy."
  },
